hostname R1
!
interface GigabitEthernet0/0
 description ## WAN Uplink to R2 (DHCP Client Mode) ##
 ip address dhcp
 no shutdown
!
interface GigabitEthernet0/1
 description ## Branch LAN Gateway (DHCP Relay Agent) ##
 ip address 192.168.1.1 255.255.255.0
 ip helper-address 203.0.113.1
 no shutdown
!
! Return route to Central Site
ip route 192.168.2.0 255.255.255.0 203.0.113.1
!
end
