! ==============================================================================
! Device: Switch0 (Distribution Switch)
! Platform: Cisco Catalyst 2960-24TT (IOS 15.0)
! Role: Layer 2 Switched Infrastructure for Core Network Services & Workstations
! ==============================================================================
version 15.0
service timestamps log datetime msec
service timestamps debug datetime msec
no service password-encryption
!
hostname Switch0
!
no ip domain-lookup
spanning-tree mode pvst
spanning-tree extend system-id
!
! --- Server Interlinks ---
interface FastEthernet0/2
 description Uplink_to_DHCP_Server
 switchport mode access
 switchport access vlan 1
!
interface FastEthernet0/3
 description Uplink_to_Web_Server
 switchport mode access
 switchport access vlan 1
!
interface FastEthernet0/4
 description Uplink_to_DNS_Server
 switchport mode access
 switchport access vlan 1
!
! --- Client Workstation Ports ---
interface FastEthernet0/1
 description Access_to_PC0
 switchport mode access
 switchport access vlan 1
!
interface FastEthernet0/5
 description Access_to_PC1
 switchport mode access
 switchport access vlan 1
!
interface Vlan1
 no ip address
 shutdown
!
line con 0
line vty 0 4
 login
line vty 5 15
 login
!
end
